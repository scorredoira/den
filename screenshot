#!/bin/sh
# Takes the README screenshots (docs/screenshots/): opens Den.app with a demo
# config of its own (dark theme, a clone of this repo with a few worktrees),
# runs Claude Code and a shell in split terminals (main.png), then shows the
# History tab (history.png), capturing the window each time, and closes it.
# Your config, agent and terminals aren't touched: the demo instance has its
# own config, state and agent socket.
#
# Usage: ./screenshot [path to Den.app]   (default /Applications/Den.app)
# The terminal running it needs Accessibility permission (it types into den);
# leave the keyboard and mouse alone while it runs.
# Claude Code runs a read-only question, which takes about a minute.
set -eu
dir="$(cd "$(dirname "$0")" && pwd)"
app="${1:-/Applications/Den.app}/Contents/MacOS/den"
shots="$dir/docs/screenshots"
# Short paths: the shell prompt shows the folder and a socket path has a limit.
# The real path (/private/tmp), the one git reports for the worktrees.
demo="$(cd "$(mktemp -d /tmp/dendemo.XXXX)" && pwd -P)"
projects="$demo/p"
socket="$demo/agent.sock"
pid=""

cleanup() {
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  lsof -t "$socket" 2>/dev/null | xargs kill 2>/dev/null
  sleep 1
  rm -rf "$demo"
  true
}
trap cleanup EXIT INT TERM

git clone -q "$dir" "$projects/den"
for branch in lsp-hover ssh-reconnect tab-drag wsl-distros; do
  git -C "$projects/den" worktree add -q -b "$branch" "$projects/wt/$branch"
done
task="$projects/wt/wsl-distros"

mkdir -p "$demo/config" "$demo/state" "$demo/zdot"
printf '["%s"]\n' "$projects/den" > "$demo/config/repos.json"
cat > "$demo/config/config.json" <<EOF
{
  "theme": "dark",
  "check_for_updates": false,
  "layout": { "side_width": 280, "dock_width": 800 },
  "window": { "x": 40, "y": 60, "width": 1800, "height": 1000, "maximized": false },
  "last": { "host": "local", "path": "$task" },
  "sessions": {
    "$task": {
      "tabs": [
        { "path": "$task/crates/ui/src/language.rs", "line": 20, "column": 4 },
        { "path": "$task/crates/proto/src/lib.rs", "line": 0, "column": 0 }
      ],
      "active": 0
    }
  }
}
EOF
cat > "$demo/zdot/.zshrc" <<'EOF'
export PATH="$HOME/.local/bin:$PATH"
PROMPT='%F{blue}%1~%f %F{magenta}❯%f '
# The question for Claude: typed in full, keystrokes get lost on the way.
q='How does this branch find WSL distros? Read crates/client/src/wsl.rs and explain it briefly, with a small table. Do not edit anything.'
EOF

# The window id of a process, for screencapture.
cat > "$demo/wid.swift" <<'EOF'
import CoreGraphics
let pid = Int32(CommandLine.arguments[1])!
let list = CGWindowListCopyWindowInfo(.optionOnScreenOnly, kCGNullWindowID) as! [[String: Any]]
for w in list where (w[kCGWindowOwnerPID as String] as? Int32) == pid && (w[kCGWindowLayer as String] as? Int) == 0 {
  print(w[kCGWindowNumber as String]!); break
}
EOF

# keys <AppleScript lines>: sends keystrokes to the demo den.
keys() {
  osascript -e "tell application \"System Events\"
    set frontmost of (first process whose unix id is $pid) to true
    delay 0.3
    $1
  end tell" >/dev/null
}
type_line() {
  keys "keystroke \"$1\"
    key code 36"
}

(cd "$task" && ZDOTDIR="$demo/zdot" DEN_CONFIG_DIR="$demo/config" DEN_STATE_DIR="$demo/state" \
  DEN_AGENT_SOCKET="$socket" exec "$app") >"$demo/app.log" 2>&1 &
pid=$!
window=""
for _ in $(seq 30); do
  window="$(swift "$demo/wid.swift" "$pid")"
  [ -n "$window" ] && break
  sleep 1
done
[ -n "$window" ] || { echo "den didn't open a window; see $demo/app.log" >&2; exit 1; }
sleep 5

echo "running Claude Code…"
type_line 'claude \"$q\"'
sleep 5
# The new folder's trust dialog: "Yes, I trust this folder" is the second option.
keys "key code 125
    delay 0.5
    key code 36"
sleep 3
keys 'keystroke "d" using {command down}'
sleep 1.5
type_line 'git status --short; git log --oneline --graph -12'
sleep 50

# shot <name>: the window, as docs/screenshots/<name>.png.
shot() {
  screencapture -x -o -l "$window" "$demo/shot.png"
  sips --resampleWidth 2400 "$demo/shot.png" --out "$shots/$1.png" >/dev/null
  echo "saved: $shots/$1.png"
}
shot main

# The History tab, the terminals out of the way, on a commit with a few files.
keys 'keystroke "j" using {command down}'
sleep 2
keys 'keystroke "h" using {command down, shift down}'
sleep 4
keys 'key code 125
    delay 0.3
    key code 125'
sleep 3
shot history
