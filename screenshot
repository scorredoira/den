#!/bin/sh
# Takes the README screenshots (docs/screenshots/): opens Den.app with a demo
# config of its own (dark theme, a clone of this repo with a few worktrees),
# runs Claude Code and a shell in split terminals (main.png), then shows an
# uncommitted change side by side (diff.png), a project search (search.png)
# and the History tab (history.png), and last, in the light theme, Markdown
# with a diagram and its outline (markdown.png),
# capturing the window each time, and closes it.
# Your config, agent and terminals aren't touched: the demo instance has its
# own config, state and agent socket.
#
# Usage: ./screenshot [path to Den.app]   (default /Applications/Den.app)
# The terminal running it needs Accessibility permission (it types into den);
# leave the keyboard and mouse alone while it runs.
# Claude Code runs a read-only question, which takes about a minute.
set -eu
dir="$(cd "$(dirname "$0")" && pwd)"
app="${1:-/Applications/Den.app}/Contents/MacOS/den"
shots="$dir/docs/screenshots"
# Short paths: the shell prompt shows the folder and a socket path has a limit.
# The real path (/private/tmp), the one git reports for the worktrees.
demo="$(cd "$(mktemp -d /tmp/dendemo.XXXX)" && pwd -P)"
projects="$demo/p"
socket="$demo/agent.sock"
pid=""

cleanup() {
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  for agent in "$demo"/*.sock; do
    lsof -t "$agent" 2>/dev/null | xargs kill 2>/dev/null
  done
  sleep 1
  rm -rf "$demo"
  true
}
trap cleanup EXIT INT TERM

git clone -q "$dir" "$projects/den"
for branch in lsp-hover ssh-reconnect tab-drag wsl-distros; do
  git -C "$projects/den" worktree add -q -b "$branch" "$projects/wt/$branch"
done
task="$projects/wt/wsl-distros"
# The branch's work in progress: an uncommitted change to review.
python3 - "$task/crates/client/src/wsl.rs" <<'PY'
import sys
path = sys.argv[1]
text = open(path).read()
old = """    parse_list(&output.stdout)
        .into_iter()
        .map(|distro| format!("{PREFIX}{distro}"))
        .collect()"""
new = """    // The default distro first, then by name, as the picker lists them.
    let mut distros = parse_list(&output.stdout);
    distros.sort_by_key(|distro| (distro != "Ubuntu", distro.to_lowercase()));
    distros.dedup();
    distros.into_iter().map(|distro| format!("{PREFIX}{distro}")).collect()"""
assert old in text, "wsl.rs changed: update the demo's change"
open(path, "w").write(text.replace(old, new))
PY

mkdir -p "$demo/config" "$demo/state" "$demo/zdot"
printf '["%s"]\n' "$projects/den" > "$demo/config/repos.json"
# config <theme>: the demo's config, with only the two files open.
config() {
  cat > "$demo/config/config.json" <<EOF
{
  "theme": "$1",
  "check_for_updates": false,
  "diff_layout": "side_by_side",
  "layout": { "side_width": 280, "dock_width": 800 },
  "window": { "x": 40, "y": 60, "width": 1800, "height": 1000, "maximized": false },
  "last": { "host": "local", "path": "$task" },
  "sessions": {
    "$task": {
      "tabs": [
        { "path": "$task/crates/ui/src/language.rs", "line": 20, "column": 4 },
        { "path": "$task/crates/proto/src/lib.rs", "line": 0, "column": 0 }
      ],
      "active": 0
    }
  }
}
EOF
}
config dark
cat > "$demo/zdot/.zshrc" <<'EOF'
export PATH="$HOME/.local/bin:$PATH"
PROMPT='%F{blue}%1~%f %F{magenta}❯%f '
# The question for Claude: typed in full, keystrokes get lost on the way.
q='How does this branch find WSL distros? Read crates/client/src/wsl.rs and explain it briefly, with a small table. Do not edit anything.'
EOF

# The window id of a process, for screencapture.
cat > "$demo/wid.swift" <<'EOF'
import CoreGraphics
let pid = Int32(CommandLine.arguments[1])!
let list = CGWindowListCopyWindowInfo(.optionOnScreenOnly, kCGNullWindowID) as! [[String: Any]]
for w in list where (w[kCGWindowOwnerPID as String] as? Int32) == pid && (w[kCGWindowLayer as String] as? Int) == 0 {
  print(w[kCGWindowNumber as String]!); break
}
EOF

# keys <AppleScript lines>: sends keystrokes to the demo den.
keys() {
  osascript -e "tell application \"System Events\"
    set frontmost of (first process whose unix id is $pid) to true
    delay 0.3
    $1
  end tell" >/dev/null
}
type_line() {
  keys "keystroke \"$1\"
    key code 36"
}

# launch: opens the demo den, its state in $state and its agent at $socket,
# and waits for its window.
launch() {
  (cd "$task" && ZDOTDIR="$demo/zdot" DEN_CONFIG_DIR="$demo/config" DEN_STATE_DIR="$state" \
    DEN_AGENT_SOCKET="$socket" exec "$app") >>"$demo/app.log" 2>&1 &
  pid=$!
  window=""
  for _ in $(seq 30); do
    window="$(swift "$demo/wid.swift" "$pid")"
    [ -n "$window" ] && break
    sleep 1
  done
  [ -n "$window" ] || { echo "den didn't open a window; see $demo/app.log" >&2; exit 1; }
  sleep 5
}
state="$demo/state"
launch

echo "running Claude Code…"
type_line 'claude \"$q\"'
sleep 5
# The new folder's trust dialog: "Yes, I trust this folder" is the second option.
keys "key code 125
    delay 0.5
    key code 36"
sleep 3
keys 'keystroke "d" using {command down}'
sleep 1.5
type_line 'git status --short; git log --oneline --graph -12'
sleep 50

# shot <name>: the window, as docs/screenshots/<name>.png.
shot() {
  screencapture -x -o -l "$window" "$demo/shot.png"
  sips --resampleWidth 2400 "$demo/shot.png" --out "$shots/$1.png" >/dev/null
  echo "saved: $shots/$1.png"
}
shot main

# The change side by side, from the shell, the terminals out of the way.
type_line 'den diff crates/client/src/wsl.rs'
sleep 3
keys 'keystroke "j" using {command down}'
sleep 2
shot diff

# A search, and its fourth match (F4) open with its line's blame.
keys 'keystroke "f" using {command down, shift down}
    delay 0.8
    keystroke "socket_path"'
sleep 3
for _ in 1 2 3 4; do
  keys 'key code 118'
  sleep 0.8
done
sleep 2
shot search

# The History tab, a commit with a few files opened from the list.
keys 'keystroke "h" using {command down, shift down}'
sleep 4
keys 'key code 125
    delay 0.3
    key code 125
    delay 0.3
    key code 36'
sleep 3
shot history

# Markdown with a diagram and its headings in the outline, in the light
# theme: a diagram is drawn for a white page. Den again, with a state and an
# agent of its own, on a note written now (the shots before don't show it as
# a change).
kill "$pid"
sleep 2
config light
cat > "$task/docs/updates.md" <<'MD'
# Updates

```mermaid
stateDiagram-v2
    [*] --> Idle
    Idle --> Checking: every few hours
    Idle --> Checking: Check for Updates
    Checking --> Idle: up to date
    Checking --> Downloading: a newer release
    Downloading --> Idle: not signed with the release key
    Downloading --> Ready: signed
    Ready --> [*]: Restart to update
```

## After the restart

Workspaces and open files reopen as they were, and terminals keep running in
the agent across the restart.
MD
state="$demo/state-light"
socket="$demo/light.sock"
mkdir -p "$state"
launch
keys 'keystroke "j" using {command down}'
sleep 1
keys 'keystroke "p" using {command down}
    delay 0.8
    keystroke "docs/updates.md"
    delay 2.5
    key code 36'
sleep 2
keys 'keystroke "l" using {command down, shift down}'
sleep 2
shot markdown
